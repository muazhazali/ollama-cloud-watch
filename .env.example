# Optional config for ollama-cloud-watch. Copy to .env; real env vars win.
# Cookie (full header) — get it from ollama.com/settings devtools cookies:
OLLAMA_COOKIE=__Secure-session=<value>

# Optional API fallback when the cookie is missing or expired:
OLLAMA_API_KEY=<key>

# Optional plan tier (free | pro | max):
OLLAMA_PLAN=pro
